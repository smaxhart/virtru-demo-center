{
  "name": "virtru-demo-center",
  "version": "1.8.4",
  "description": "Virtru Demo Center — self-contained Electron app with embedded OpenTDF platform",
  "author": "Virtru",
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"electron .\"",
    "dev:web": "vite",
    "build": "vite build",
    "build:platform": "bash scripts/build-platform.sh",
    "electron": "electron .",
    "dist": "vite build && electron-builder --mac --arm64",
    "release:beta": "node scripts/release.mjs beta",
    "release": "node scripts/release.mjs stable",
    "release:check": "node scripts/release.mjs stable --dry-run",
    "release:check:beta": "node scripts/release.mjs beta --dry-run",
    "postinstall": "electron-builder install-app-deps",
    "verify": "npm run verify:pages && npm run verify:updater && npm run verify:matrix && npm run verify:uploads && npm run verify:scenario",
    "verify:pages": "node scripts/verify-pages.mjs",
    "verify:updater": "node scripts/verify-updater.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs",
    "verify:uploads": "node scripts/verify-uploads.mjs",
    "verify:scenario": "node scripts/verify-scenario.mjs"
  },
  "dependencies": {
    "@opentdf/sdk": "^0.19.0",
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "leaflet": "^1.9.4",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "com.virtru.demo-center",
    "productName": "Virtru Demo Center",
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "files": [
      "dist/**",
      "electron/**",
      "platform-config/**",
      "!resources/bin",
      "!dist/*.{dmg,zip,blockmap,yml,yaml}",
      "!dist/*.zip.blockmap",
      "!dist/*.dmg.blockmap",
      "!dist/mac*"
    ],
    "extraResources": [
      {
        "from": "resources/bin/opentdf-platform-darwin-arm64",
        "to": "bin/opentdf-platform"
      },
      {
        "from": "resources/postgres",
        "to": "postgres"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "smaxhart",
      "repo": "virtru-demo-center",
      "private": true,
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "fsevents@2.3.3": true
  }
}
