<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for Electron's V8 JIT -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- Required for Electron's code signing checks -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required to spawn the OpenTDF Go sidecar binary -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Allow outbound network connections to localhost services -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Allow reading/writing files the user selects via open/save dialogs -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
